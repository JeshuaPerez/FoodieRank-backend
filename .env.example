NODE_ENV=development
PORT=3000

# Atlas: el cluster M0 ya es replica set, requisito para las transacciones
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
DB_NAME=foodierank

# Cuanto espera el driver antes de dar la conexion por perdida
DB_SELECTION_TIMEOUT_MS=10000

JWT_SECRET=cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Lista separada por comas. Live Server usa 5500
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# Credenciales del administrador que crea el seed
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@foodierank.com
ADMIN_PASSWORD=Admin123*
